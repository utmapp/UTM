From 7ebc0f66a395c846018deddd1b931f88b63613e9 Mon Sep 17 00:00:00 2001
From: Dragos Hont <2241895+dragoshont@users.noreply.github.com>
Date: Sun, 18 Oct 2026 12:48:28 +0300
Subject: [PATCH] virtio-gpu: add a refresh_rate property for displays that
 report none

The EDID only carries the host refresh rate when the display reports it
in QemuUIInfo. GTK and Cocoa do, but SPICE has no field for it, so a
SPICE guest always gets a synthesised 75 Hz mode. On a 60 Hz host
display about one frame in five is rendered and never shown, and a
120 Hz display can't be used.

Add a refresh_rate property (mHz, default 0) to the virtio-gpu base
device. It seeds every output and is used whenever the display reports
no rate, e.g.

  -device virtio-gpu-pci,refresh_rate=60000

Values below 1000 are rejected, since a rate passed in Hz would produce
a ~0.06 Hz mode.

Signed-off-by: Dragos Hont <2241895+dragoshont@users.noreply.github.com>
Assisted-by: GitHub Copilot:claude-opus-5.5
Assisted-by: Claude:claude-opus-5-5
---
 hw/display/virtio-gpu-base.c   | 10 +++++++++-
 include/hw/virtio/virtio-gpu.h |  5 ++++-
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/hw/display/virtio-gpu-base.c b/hw/display/virtio-gpu-base.c
index 7827536ac4..adf9bb25c2 100644
--- a/hw/display/virtio-gpu-base.c
+++ b/hw/display/virtio-gpu-base.c
@@ -96,7 +96,9 @@ static void virtio_gpu_ui_info(void *opaque, uint32_t idx, QemuUIInfo *info)
 
     g->req_state[idx].x = info->xoff;
     g->req_state[idx].y = info->yoff;
-    g->req_state[idx].refresh_rate = info->refresh_rate;
+    /* displays such as SPICE report no rate */
+    g->req_state[idx].refresh_rate = info->refresh_rate ? info->refresh_rate
+                                                        : g->conf.refresh_rate;
     g->req_state[idx].width = info->width;
     g->req_state[idx].height = info->height;
     g->req_state[idx].width_mm = info->width_mm;
@@ -182,6 +184,11 @@ virtio_gpu_base_device_realize(DeviceState *qdev,
         return false;
     }
 
+    if (g->conf.refresh_rate && g->conf.refresh_rate < 1000) {
+        error_setg(errp, "refresh_rate is in mHz, e.g. 60000 for 60 Hz");
+        return false;
+    }
+
     if (virtio_gpu_virgl_enabled(g->conf)) {
         error_setg(&g->migration_blocker, "virgl is not yet migratable");
         if (migrate_add_blocker(&g->migration_blocker, errp) < 0) {
@@ -209,6 +216,7 @@ virtio_gpu_base_device_realize(DeviceState *qdev,
 
     g->hw_ops = &virtio_gpu_ops;
     for (i = 0; i < g->conf.max_outputs; i++) {
+        g->req_state[i].refresh_rate = g->conf.refresh_rate;
         g->scanout[i].con =
             graphic_console_init(DEVICE(g), i, &virtio_gpu_ops, g);
     }
diff --git a/include/hw/virtio/virtio-gpu.h b/include/hw/virtio/virtio-gpu.h
index de53f96d6c..2af06db3e4 100644
--- a/include/hw/virtio/virtio-gpu.h
+++ b/include/hw/virtio/virtio-gpu.h
@@ -131,6 +131,8 @@ struct virtio_gpu_base_conf {
     uint32_t flags;
     uint32_t xres;
     uint32_t yres;
+    /* mHz, used when the display reports none */
+    uint32_t refresh_rate;
     uint64_t hostmem;
 };
 
@@ -194,7 +196,8 @@ struct VirtIOGPUBaseClass {
     DEFINE_PROP_BIT("edid", _state, _conf.flags, \
                     VIRTIO_GPU_FLAG_EDID_ENABLED, true), \
     DEFINE_PROP_UINT32("xres", _state, _conf.xres, 1280), \
-    DEFINE_PROP_UINT32("yres", _state, _conf.yres, 800)
+    DEFINE_PROP_UINT32("yres", _state, _conf.yres, 800), \
+    DEFINE_PROP_UINT32("refresh_rate", _state, _conf.refresh_rate, 0)
 
 typedef struct VGPUDMABuf {
     QemuDmaBuf *buf;
