+}
+
+void hvf_arm_gic_set_ppi(CPUState *cpu, uint32_t intid, int level)
+{
+}
+
+static void hvf_arm_gic_flush_ppis(CPUState *cpu)
+{
+}
+
+void hvf_arm_gic_reset(void)
+{
+}
