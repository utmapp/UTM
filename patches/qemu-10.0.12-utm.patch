     struct virgl_renderer_resource_create_args args;
@@ -403,6 +427,9 @@ static void virgl_cmd_create_resource_2d(VirtIOGPU *g,
 
     res = virtio_gpu_virgl_find_resource(g, c2d.resource_id);
