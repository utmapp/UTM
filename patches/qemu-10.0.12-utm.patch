-                                         self.scanoutRect.origin.y + rect.origin.y,
-                                         0);
-        MTLSize size = MTLSizeMake(rect.size.width, rect.size.height, 1);
-
-        [blit copyFromTexture:self.scanoutTexture
-                  sourceSlice:0
