      * context.
      */
     gl = VIRTIO_GPU_GL(vmr->g);
+    QTAILQ_INSERT_TAIL(&gl->unmap_done_list, vmr, done_next);
     qemu_bh_schedule(gl->cmdq_resume_bh);
 }
 
@@ -170,6 +241,7 @@ virtio_gpu_virgl_map_resource_blob(VirtIOGPU *g,
