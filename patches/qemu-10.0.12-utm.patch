From 40b5b1ff33e69ad46bac12aeba5acc6d90d5d9ee Mon Sep 17 00:00:00 2001
From: osy <osy@turing.llc>
Date: Wed, 7 Oct 2026 00:29:47 -0700
Subject: [PATCH 2/3] virtio-gpu: let a create wait for a deferred unref of the
 same id

An UNREF of a still-mapped blob is deferred until its MemoryRegion
finalizes while the control queue keeps flowing (3bdba2ae2e).  A guest
that reuses the id as soon as it has queued the UNREF -- the Windows
viogpu3d KMD does when it re-establishes its blob windows -- had its
CREATE rejected with INVALID_RESOURCE_ID ("resource already exists") and
came up with no display.

Park a CREATE_2D/3D/BLOB whose id has a deferred unref at the cmdq head,
the way a re-MAP is parked.  The unmap completion releases the block,
completes the unref and resumes the queue, and the create re-runs
against a free id.

Assisted-by: Claude:claude-fable-5-1
---
 hw/display/virtio-gpu-virgl.c | 61 ++++++++++++++++++++++++++++-------
 1 file changed, 50 insertions(+), 11 deletions(-)

diff --git a/hw/display/virtio-gpu-virgl.c b/hw/display/virtio-gpu-virgl.c
index 2592fb4e77..a57f9e0e48 100644
--- a/hw/display/virtio-gpu-virgl.c
+++ b/hw/display/virtio-gpu-virgl.c
@@ -68,6 +68,29 @@ virtio_gpu_virgl_find_resource(VirtIOGPU *g, uint32_t resource_id)
     return container_of(res, struct virtio_gpu_virgl_resource, base);
 }
 
+/*
+ * A guest may reuse a resource id as soon as it has queued the UNREF, but
+ * the UNREF of a mapped blob completes only when its MemoryRegion
+ * finalizes.  Park a create of that id at the cmdq head, as a re-MAP is
+ * parked; the finalizer releases the block, completes the unref and
+ * resumes the queue.  Returns true if the create was parked.
+ */
+static bool
+virtio_gpu_virgl_create_waits_for_unref(VirtIOGPU *g,
+                                        struct virtio_gpu_virgl_resource *res,
+                                        bool *cmd_suspended)
+{
+    if (!res->unref_cmd) {
+        return false;
+    }
+    if (!res->map_blocked) {
+        res->map_blocked = true;
+        VIRTIO_GPU_BASE(g)->renderer_blocked++;
+    }
+    *cmd_suspended = true;
+    return true;
+}
+
 #if VIRGL_RENDERER_CALLBACKS_VERSION >= 4
 static void *
 virgl_get_egl_display(G_GNUC_UNUSED void *cookie)
@@ -384,7 +407,8 @@ void virtio_gpu_virgl_resource_destroy(VirtIOGPU *g,
 }
 
