+    ssd->y_0_top = y_0_top;
+    ssd->scanout_last_x = x;
+    ssd->scanout_last_y = y;
+    ssd->scanout_last_w = w;
+    ssd->scanout_last_h = h;
+    fd = spice_iosurface_create_fd(ssd, &fourcc);
 #endif
     if (fd < 0) {
         fprintf(stderr, "%s: failed to get fd for texture\n", __func__);
