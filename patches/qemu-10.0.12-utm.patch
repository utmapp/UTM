+/* every DisplayID field is stored one less than it counts */
+static void displayid_clock(uint8_t *dst, uint32_t clock)
+{
+    clock--;
+    dst[0] = clock & 0xff;
+    dst[1] = (clock & 0xff00) >> 8;
+    dst[2] = (clock & 0xff0000) >> 16;
