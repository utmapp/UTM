     struct virgl_renderer_resource_create_args args;
@@ -451,6 +479,9 @@ static void virgl_cmd_create_resource_3d(VirtIOGPU *g,
 
     res = virtio_gpu_virgl_find_resource(g, c3d.resource_id);
