index 52a5b33b92..611469f63b 100644
--- a/target/arm/cpu.h
+++ b/target/arm/cpu.h
@@ -22,6 +22,7 @@
 
 #include "kvm-consts.h"
 #include "qemu/cpu-float.h"
+#include "qemu/seqlock.h"
 #include "hw/registerfields.h"
 #include "cpu-qom.h"
 #include "exec/cpu-defs.h"
@@ -900,6 +901,14 @@ struct ArchCPU {
