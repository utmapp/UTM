+            error_setg(errp, "the HVF in-kernel GIC state cannot be saved");
+            return -1;
+        }
+        ret = hv_gic_state_get_size(state, &size);
+        if (ret == HV_SUCCESS && size > UINT32_MAX) {
+            ret = HV_NO_RESOURCES;
+        }
+        if (ret == HV_SUCCESS) {
