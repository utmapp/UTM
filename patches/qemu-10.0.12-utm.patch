-        cmd->finished = false;
-        cmd->suspended = false;
-        cmd->deferred = false;
+        virtio_gpu_ctrl_cmd_init(cmd, vq);
         QTAILQ_INSERT_TAIL(&g->cmdq, cmd, next);
         cmd = virtqueue_pop(vq, sizeof(struct virtio_gpu_ctrl_command));
     }
diff --git a/include/hw/virtio/virtio-gpu.h b/include/hw/virtio/virtio-gpu.h
index b103a5682d..de53f96d6c 100644
--- a/include/hw/virtio/virtio-gpu.h
+++ b/include/hw/virtio/virtio-gpu.h
@@ -151,6 +151,18 @@ struct virtio_gpu_ctrl_command {
     QTAILQ_ENTRY(virtio_gpu_ctrl_command) next;
 };
 
+/* virtqueue_pop() does not zero the element, so every popper must reset
+ * the per-command state that virtio_gpu_process_cmdq() reads. */
+static inline void virtio_gpu_ctrl_cmd_init(struct virtio_gpu_ctrl_command *cmd,
+                                            VirtQueue *vq)
+{
+    cmd->vq = vq;
+    cmd->error = 0;
+    cmd->finished = false;
+    cmd->suspended = false;
+    cmd->deferred = false;
+}
+
 struct VirtIOGPUBase {
     VirtIODevice parent_obj;
 
