 target/arm/cpu.h     |   9 ++++
 target/arm/helper.c  |  12 +++++
 target/arm/hvf/hvf.c | 104 +++++++++++++++++++++++++++++++++++++++++--
 4 files changed, 124 insertions(+), 3 deletions(-)

