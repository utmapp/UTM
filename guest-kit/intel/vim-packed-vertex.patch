@@ -632,6 +632,17 @@ static size_t DGVertexBytes(uint32_t type)
     default:return 0;
     }
 }
+/* Packed formats (ARB_vertex_type_2_10_10_10_rev, ARB_vertex_type_10f_11f_11f_rev):
+ * one 32-bit word holds all four (three) components, so the element size is
+ * not component bytes times size. GL 3.3/4.1 core games (SuperTuxKart's packed
+ * normals and tangents) depend on these. */
+static int DGPackedVertexType(uint32_t type)
+{ return type==0x8d9f || type==0x8368 || type==0x8c3b; }
+static size_t DGVertexElementBytes(uint32_t type,uint32_t size)
+{
+    if(DGPackedVertexType(type))return size==(type==0x8c3b?3u:4u)?4:0;
+    return DGVertexBytes(type)*size;
+}
